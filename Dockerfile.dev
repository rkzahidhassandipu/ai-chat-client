FROM node:22-alpine

WORKDIR /app

# ১. আগে ডিপেন্ডেন্সি ফাইলগুলো কপি করে ইনস্টল করে নিচ্ছি
COPY package*.json ./
RUN npm install

# ২. সোর্স কোড কপি করছি (যদিও ডকার-কম্পোজ ভলিউম এটাকে ওভাররাইট করবে, তবুও সেফটি হিসেবে রাখা ভালো)
COPY . .

EXPOSE 3000

# ৩. লোকাল ডেভেলপমেন্টের জন্য Next.js এর ক্র্যাশ এড়াতে dev কমান্ড রান করাচ্ছি
CMD ["npm", "run", "dev"]